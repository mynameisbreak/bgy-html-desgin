{
  "id": "monthly-review",
  "label": "月报季报",
  "description": "指标先行，适合复盘、趋势和结果汇报。",
  "projectType": "monthly-review",
  "theme": {
    "brand": "#0F766E",
    "deepBrand": "#134E4A",
    "success": "#15803D",
    "successBg": "#EAF7EF",
    "warning": "#B7791F",
    "warningBg": "#FFF7E6",
    "danger": "#B91C1C",
    "dangerBg": "#FEF2F2",
    "info": "#2563EB",
    "infoBg": "#EFF6FF",
    "text": "#1E293B",
    "muted": "#64748B",
    "panel": "#F0FDFA",
    "surface": "#FFFFFF",
    "pageBg": "#FFFFFF",
    "line": "#CCE7E2",
    "chart": ["#0F766E", "#2563EB", "#15803D", "#B7791F", "#64748B"]
  },
  "components": {
